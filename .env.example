# =====================================================================
#  Copiar a .env y completar. El .env NO se commitea (está en .gitignore).
#  Las claves se generan una vez, al instalar el servidor de la clínica.
# =====================================================================

# Contraseña de PostgreSQL. Larga y sin reutilizar de otro sistema.
POSTGRES_PASSWORD=

# Secreto para firmar los tokens de sesión. Mínimo 32 caracteres.
#   openssl rand -base64 48
JWT_SECRET=

# Claves derivadas del JWT_SECRET. Se generan con la herramienta de
# Supabase (supabase.com/docs/guides/self-hosting#api-keys) o con el
# script que quede en docs/.
ANON_KEY=
SERVICE_ROLE_KEY=

# La dirección del servidor en la red de la clínica.
SITE_URL=http://servidor-cml

# Puertos públicos de Kong y de la app. Dejar por defecto (8000 / 80) en
# el servidor dedicado de la clínica. Solo se pisan en una máquina
# compartida con otros proyectos, para no chocar con un puerto ya usado.
KONG_PUERTO_PUBLICO=8000
APP_PUERTO_PUBLICO=80

# --- lo que lee la aplicación React (app/.env) ---
VITE_SUPABASE_URL=http://servidor-cml:8000
VITE_SUPABASE_ANON_KEY=
